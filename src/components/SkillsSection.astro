---
import { Code, Brain, Database, Wrench, CheckCircle } from 'lucide-react';

interface SkillCategory {
  name: string;
  skills: string[];
}

interface Props {
  categories: SkillCategory[];
}

const { categories } = Astro.props;
const allCategories = ['Semua', ...categories.map((c) => c.name)];
---

<section id="skills" class="py-16 bg-[#f7f7f7]">
  <div class="max-w-7xl mx-auto px-6">
    
    {/* Section Header */}
    <div class="flex flex-col items-center text-center space-y-3 mb-12">
      <span class="text-[14px] font-bold uppercase tracking-wide text-[#757575]">
        Keahlian Teknis & Tools
      </span>
      <h2 class="text-4xl font-bold text-black">
        Tech Stack & Kompetensi
      </h2>
      <p class="text-[#757575] max-w-xl text-base">
        Teknologi dan alat pemrograman yang saya kuasai untuk membangun aplikasi berperforma tinggi.
      </p>
    </div>

    {/* Filter Tabs */}
    <div class="flex items-center justify-center flex-wrap gap-3 mb-14">
      {allCategories.map((cat) => (
        <button
          data-skill-filter={cat}
          class={`skill-filter-btn px-5 py-2.5 rounded-[2px] text-sm font-bold transition-colors flex items-center gap-2 cursor-pointer border ${
            cat === 'Semua'
              ? 'active-tab bg-black text-white border-black'
              : 'bg-transparent text-black border-[#cccccc]'
          }`}
        >
          {cat === 'Web Development' && <Code className="w-4 h-4" />}
          {cat === 'AI & Computer Vision' && <Brain className="w-4 h-4" />}
          {cat === 'Database & Storage' && <Database className="w-4 h-4" />}
          {cat === 'DevOps & Tools' && <Wrench className="w-4 h-4" />}
          <span>{cat}</span>
        </button>
      ))}
    </div>

    {/* Skills Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.map((category) => (
        <div
          data-skill-category={category.name}
          class="skill-card relative p-6 rounded-[2px] bg-white border border-[#cccccc] flex flex-col justify-between"
        >
          {/* Corner Square */}
          <div class="absolute -top-[1px] -left-[1px] w-3 h-3 bg-[#76b900]"></div>

          <div>
            <div class="flex items-center gap-3 mb-5 mt-2">
              <div class="text-[#76b900]">
                {category.name === 'Web Development' && <Code className="w-6 h-6" />}
                {category.name === 'AI & Computer Vision' && <Brain className="w-6 h-6" />}
                {category.name === 'Database & Storage' && <Database className="w-6 h-6" />}
                {category.name === 'DevOps & Tools' && <Wrench className="w-6 h-6" />}
              </div>
              <h3 class="text-lg font-bold text-black">{category.name}</h3>
            </div>

            <div class="flex flex-wrap gap-2 mt-4">
              {category.skills.map((skill) => (
                <span
                  class="px-3 py-1.5 rounded-[2px] text-xs font-medium bg-[#f7f7f7] text-[#1a1a1a] border border-[#cccccc] flex items-center gap-1.5"
                >
                  <CheckCircle className="w-3 h-3 text-[#76b900]" />
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-[#cccccc] flex items-center justify-between text-xs text-[#757575]">
            <span>{category.skills.length} Validated Skills</span>
            {/* <span class="text-black font-bold">Astro / React</span> */}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.skill-filter-btn');
    const skillCards = document.querySelectorAll('.skill-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-skill-filter');

        // Reset active style on all filter buttons
        filterBtns.forEach((b) => {
          b.classList.remove('bg-black', 'text-white', 'border-black', 'active-tab');
          b.classList.add('bg-transparent', 'text-black', 'border-[#cccccc]');
        });

        // Add active style to clicked button
        btn.classList.add('bg-black', 'text-white', 'border-black', 'active-tab');
        btn.classList.remove('bg-transparent', 'text-black', 'border-[#cccccc]');

        // Show/hide matching cards
        skillCards.forEach((card) => {
          const cardCat = card.getAttribute('data-skill-category');
          if (targetCategory === 'Semua' || cardCat === targetCategory) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>

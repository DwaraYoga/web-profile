---
import { GraduationCap, Award, BookOpen, Cpu, CheckCircle2 } from 'lucide-react';

interface Props {
  education: {
    university: string;
    degree: string;
    gpa: string;
    period: string;
    thesis: string;
  };
}

const { education } = Astro.props;
const thesisTags = ['Faster R-CNN', 'PyTorch', 'Python', 'Computer Vision', 'React.js', 'FastAPI', 'Medical AI'];
---

<section id="about" class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    
    {/* Section Header */}
    <div class="flex flex-col items-center text-center space-y-3 mb-16">
      <span class="text-[14px] font-bold uppercase tracking-wide text-[#757575]">
        Latar Belakang & Pendidikan
      </span>
      <h2 class="text-4xl font-bold text-black">
        Pendidikan & Riset Utama
      </h2>
      <p class="text-[#757575] max-w-xl text-base">
        Kombinasi akademik di UNY dan riset Artificial Intelligence.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      {/* Education Card */}
      <div class="lg:col-span-5 relative p-8 rounded-[2px] bg-white border border-[#cccccc] flex flex-col justify-between">
        {/* Corner Square */}
        <div class="absolute -top-[1px] -left-[1px] w-3 h-3 bg-[#76b900]"></div>

        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <div class="text-[#76b900]">
              <GraduationCap className="w-8 h-8" />
            </div>
            <span class="px-3.5 py-1 text-sm font-semibold bg-[#f7f7f7] text-[#1a1a1a] border border-[#cccccc] rounded-[2px]">
              {education.period}
            </span>
          </div>

          <div>
            <h3 class="text-2xl font-bold text-black">{education.university}</h3>
            <p class="text-lg font-bold text-[#76b900] mt-1">{education.degree}</p>
          </div>

          <div class="p-4 rounded-[2px] bg-[#f7f7f7] border border-[#cccccc] flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Award className="w-5 h-5 text-[#1a1a1a]" />
              <span class="text-sm font-medium text-[#1a1a1a]">IPK Kelulusan</span>
            </div>
            <span class="text-lg font-bold text-[#76b900]">{education.gpa}</span>
          </div>
        </div>

        <div class="pt-6 border-t border-[#cccccc] mt-6">
          <div class="flex items-center gap-2 text-sm font-semibold text-[#76b900]">
            <CheckCircle2 className="w-4 h-4 text-[#76b900]" />
            <span></span>
          </div>
        </div>
      </div>

      {/* Thesis / Skripsi Highlight Card */}
      <div class="lg:col-span-7 relative p-8 rounded-[2px] bg-[#f7f7f7] border border-[#cccccc] flex flex-col justify-between">
        {/* Corner Square */}
        <div class="absolute -bottom-[1px] -right-[1px] w-3 h-3 bg-[#76b900]"></div>

        <div class="space-y-5">
          <div class="flex items-center gap-2 text-sm text-[#757575] font-bold uppercase tracking-wide">
            <BookOpen className="w-4 h-4" />
            <span>Fokus Penelitian Tugas Akhir (Skripsi)</span>
          </div>

          <h3 class="text-2xl font-bold text-black leading-snug">
            {education.thesis}
          </h3>

          <p class="text-[#1a1a1a] text-base leading-relaxed">
            Riset ini mengintegrasikan arsitektur deep learning <strong class="font-bold">Faster R-CNN</strong> berbasis PyTorch dengan antarmuka web interaktif Flask. System mampu melakukan deteksi otomatis area kelainan gigi dari citra foto.
          </p>

          {/* Tech badges for thesis */}
          <div class="flex flex-wrap gap-2 pt-2">
            {thesisTags.map((tag) => (
              <span class="px-3 py-1.5 text-sm rounded-[2px] bg-white border border-[#cccccc] text-[#1a1a1a] flex items-center gap-1.5">
                <Cpu className="w-4 h-4 text-[#1a1a1a]" />
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-[#cccccc] flex items-center justify-between text-sm text-[#757575]">
          <span>UNY • Dept. Pendidikan Teknik Elektronika dan Informatika</span>
          <span class="text-black font-bold">AI Medical Research</span>
        </div>
      </div>

    </div>
  </div>
</section>

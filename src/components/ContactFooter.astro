---
import { Mail, Copy, Check, Code2 } from 'lucide-react';
import GithubIcon from './GithubIcon.astro';
import LinkedinIcon from './LinkedinIcon.astro';

interface Props {
  contact: {
    email: string;
    location: string;
    status: string;
    github: string;
    linkedin: string;
  };
  name: string;
}

const { contact, name } = Astro.props;
---

<footer id="contact" class="flex flex-col bg-black w-full">
  {/* CTA Strip */}
  <div class="py-16 px-6 max-w-7xl mx-auto w-full flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="space-y-3 text-center md:text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-[#76b900]">
        TERBUKA UNTUK KESEMPATAN KERJA
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white">
        Tertarik Bekerja Sama?
      </h2>
      <p class="text-white/70 max-w-lg text-sm sm:text-base">
        Saya siap berkontribusi dalam tim Anda untuk posisi Full-Stack Developer atau AI Developer.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
      <button
        id="copy-email-btn"
        data-email={contact.email}
        class="w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-3 bg-[#1a1a1a] border border-[#5e5e5e] text-white rounded-[2px] text-sm font-bold transition-colors hover:border-[#cccccc]"
      >
        <Copy id="icon-copy" className="w-4 h-4 text-white" />
        <Check id="icon-check" className="w-4 h-4 text-[#76b900] hidden" />
        <span id="copy-email-text">{contact.email}</span>
      </button>

      <a
        href={`mailto:${contact.email}`}
        class="w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-3 bg-[#76b900] text-black font-bold rounded-[2px] text-sm transition-colors hover:bg-[#5a8d00]"
      >
        <Mail className="w-5 h-5 text-black" />
        <span>Kirim Email</span>
      </a>
    </div>
  </div>

  {/* Footer Bottom */}
  <div class="border-t border-[#5e5e5e]">
    <div class="max-w-7xl mx-auto px-6 py-16 flex flex-col md:flex-row items-center justify-between gap-8 text-sm">
      
      {/* Left Brand */}
      <div class="flex items-center gap-2 text-white/70">
        <Code2 className="w-5 h-5 text-[#76b900]" />
        <span class="font-bold text-white">{name}</span>
        <span>•</span>
        <span>Information Technology</span>
      </div>

      {/* Social Links */}
      <div class="flex items-center gap-6">
        <a
          href={contact.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-white/70 hover:text-[#76b900] transition-colors font-bold"
        >
          <GithubIcon class="w-5 h-5" />
          <span>GitHub</span>
        </a>
        <a
          href={contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-white/70 hover:text-[#76b900] transition-colors font-bold"
        >
          <LinkedinIcon class="w-5 h-5" />
          <span>LinkedIn</span>
        </a>
      </div>

      {/* Right Copyright */}
      <div class="text-xs text-[#757575] font-bold uppercase tracking-wider">
        © {new Date().getFullYear()} {name}
      </div>

    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-email-btn');
    const iconCopy = document.getElementById('icon-copy');
    const iconCheck = document.getElementById('icon-check');
    const textSpan = document.getElementById('copy-email-text');

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const email = copyBtn.getAttribute('data-email');
        if (email) {
          navigator.clipboard.writeText(email);
          if (iconCopy) iconCopy.classList.add('hidden');
          if (iconCheck) iconCheck.classList.remove('hidden');
          if (textSpan) textSpan.textContent = 'Email Tersalin!';

          setTimeout(() => {
            if (iconCopy) iconCopy.classList.remove('hidden');
            if (iconCheck) iconCheck.classList.add('hidden');
            if (textSpan) textSpan.textContent = email;
          }, 2000);
        }
      });
    }
  });
</script>

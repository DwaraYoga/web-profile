---
import { Eye, Mail, Sparkles, MapPin, GraduationCap, ArrowRight } from 'lucide-react';
import GithubIcon from './GithubIcon.astro';
import LinkedinIcon from './LinkedinIcon.astro';

interface Props {
  profile: {
    name: string;
    title: string;
    role: string;
    bio: string;
    avatar: string;
    cvUrl: string;
    education: {
      university: string;
      degree: string;
      gpa: string;
    };
    contact: {
      email: string;
      location: string;
      status: string;
      github: string;
      linkedin: string;
    };
  };
}

const { profile } = Astro.props;
---

<section class="relative min-h-[100dvh] pt-32 pb-24 bg-black flex items-center justify-center font-['Inter']">
  <div class="max-w-7xl mx-auto px-6 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {/* Left Column - Text Content (7 cols) */}
      <div class="lg:col-span-7 flex flex-col space-y-8">
        
        {/* Availability Badge */}
        <div class="inline-flex items-center gap-2 px-3 py-1.5 border border-[#76b900]/40 rounded-[2px] bg-[#1a1a1a] w-fit">
          <span class="w-2 h-2 rounded-full bg-[#76b900]"></span>
          <span class="text-xs font-bold text-white uppercase tracking-wider">{profile.contact.status}</span>
        </div>

        {/* Headlines */}
        <div class="space-y-4">
          <h1 class="text-5xl sm:text-6xl font-bold text-white leading-tight">
            Hai, Saya <span class="text-[#76b900]">{profile.name}</span>
          </h1>
          <div class="flex items-center gap-4 flex-wrap text-[rgba(255,255,255,0.7)] text-lg sm:text-xl font-medium">
            <span>{profile.role}</span>
            <span class="text-[#cccccc]">•</span>
            <span>UNY IPK {profile.education.gpa.split(' ')[0]}</span>
          </div>
        </div>

        {/* Bio */}
        <p class="text-[rgba(255,255,255,0.7)] text-base sm:text-lg leading-relaxed max-w-2xl">
          {profile.bio}
        </p>

        {/* Actions */}
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button
            data-open-pdf={profile.cvUrl}
            data-pdf-title="Curriculum Vitae - Dwara Yoga Pradana"
            class="bg-[#76b900] hover:bg-[#5a8d00] text-black font-bold px-7 py-3.5 rounded-[2px] transition-colors cursor-pointer"
          >
            Pratinjau CV
          </button>
          
          <a
            href="#projects"
            class="bg-transparent border border-white text-white hover:bg-white hover:text-black font-bold px-7 py-3.5 rounded-[2px] transition-colors"
          >
            Lihat Karya
          </a>
        </div>

        {/* Socials & Location */}
        <div class="pt-6 mt-2 flex flex-col sm:flex-row sm:items-center justify-between border-t border-[#cccccc]/20 gap-4">
          <div class="flex items-center gap-4">
            <a
              href={profile.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white hover:text-[#76b900] transition-colors"
              aria-label="GitHub"
            >
              <GithubIcon class="w-6 h-6" />
            </a>
            <a
              href={profile.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white hover:text-[#76b900] transition-colors"
              aria-label="LinkedIn"
            >
              <LinkedinIcon class="w-6 h-6" />
            </a>
            <a
              href={`mailto:${profile.contact.email}`}
              class="text-white hover:text-[#76b900] transition-colors"
              aria-label="Email"
            >
              <Mail className="w-6 h-6" />
            </a>
          </div>

          <div class="flex items-center gap-2 text-white">
            <MapPin className="w-4 h-4 text-[#76b900]" />
            <span class="text-sm font-medium">{profile.contact.location}</span>
          </div>
        </div>

      </div>

      {/* Right Column - Avatar (5 cols) */}
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative">
          {/* Main Avatar Card */}
          <div class="relative w-64 h-64 sm:w-80 sm:h-80 bg-[#1a1a1a] rounded-[2px] border border-white/20 p-2">
            <img
              src={profile.avatar}
              alt={profile.name}
              class="w-full h-full object-cover rounded-[2px] grayscale hover:grayscale-0 transition-all duration-500"
            />
            
            {/* Signature NVIDIA Corner Square */}
            <div class="absolute -top-3 -right-3 w-3 h-3 bg-[#76b900]"></div>
          </div>

          {/* Floating Stat Badges */}
          <div class="absolute -bottom-6 -left-8 px-4 py-3 bg-[#1a1a1a] border border-[#5e5e5e] rounded-[2px] flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-[#76b900]"></div>
            <div>
              <p class="text-[10px] text-[rgba(255,255,255,0.7)] uppercase font-bold tracking-wider">Skripsi Research</p>
              <p class="text-sm font-bold text-white">Faster R-CNN Web Diagnosis</p>
            </div>
          </div>

          <div class="absolute -top-6 -left-4 px-4 py-2 bg-[#1a1a1a] border border-[#5e5e5e] rounded-[2px] flex items-center gap-2">
            <span class="text-xs font-bold text-white uppercase">IPK 3.83</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

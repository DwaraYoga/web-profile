---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import PdfModal from '../../components/PdfModal.astro';
import GithubIcon from '../../components/GithubIcon.astro';
import profileData from '../../content/profile.json';
import { getCollection, type CollectionEntry, render } from 'astro:content';
import { ArrowLeft, ExternalLink, Calendar, Sparkles } from 'lucide-react';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Portofolio ${profileData.name}`}
  description={project.data.description}
  image={project.data.image}
>
  <Navbar />

  <main class="pt-32 pb-20 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      {/* Back Button */}
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-[2px] bg-[#f7f7f7] border border-[#cccccc] text-[#1a1a1a] hover:bg-[#cccccc]/30 text-sm font-bold transition-all mb-8"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>Kembali ke Beranda</span>
      </a>

      {/* Hero Header Card */}
      <div class="p-8 sm:p-10 rounded-[2px] bg-white border border-[#cccccc] space-y-6 mb-12 relative">
        {/* NVIDIA Signature Corner Square */}
        <div class="absolute top-0 right-0 w-3 h-3 bg-[#76b900]"></div>

        <div class="flex items-center justify-between gap-4 flex-wrap">
          <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider text-[#1a1a1a] bg-[#f7f7f7] border border-[#cccccc] rounded-[2px]">
            {project.data.category || 'Web Development'}
          </span>
          
          <div class="flex items-center gap-3">
            {project.data.featured && (
              <span class="px-3 py-1 rounded-[2px] bg-[#76b900] text-black text-xs font-bold flex items-center gap-1">
                <Sparkles className="w-3.5 h-3.5" />
                <span>Featured Project</span>
              </span>
            )}
            <span class="text-xs text-[#757575] flex items-center gap-1 font-bold">
              <Calendar className="w-3.5 h-3.5 text-[#1a1a1a]" />
              {project.data.year}
            </span>
          </div>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold text-black leading-tight">
          {project.data.title}
        </h1>

        <p class="text-[#1a1a1a] text-lg leading-relaxed">
          {project.data.description}
        </p>

        {/* Tech Stack Badges */}
        <div class="flex flex-wrap gap-2 pt-6 border-t border-[#cccccc]">
          {project.data.tech_stack.map((tech) => (
            <span
              class="px-3 py-1 rounded-[2px] text-xs font-bold bg-[#f7f7f7] text-[#1a1a1a] border border-[#cccccc]"
            >
              {tech}
            </span>
          ))}
        </div>

        {/* Action buttons */}
        <div class="flex flex-wrap items-center gap-4 pt-4">
          {project.data.demo_url && (
            <a
              href={project.data.demo_url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-6 py-3 bg-[#76b900] hover:bg-[#5a8d00] text-black font-bold rounded-[2px] transition-all"
            >
              <ExternalLink className="w-4 h-4" />
              <span>Kunjungi Live Demo</span>
            </a>
          )}

          {project.data.github_url && (
            <a
              href={project.data.github_url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-6 py-3 bg-white hover:bg-[#f7f7f7] text-black font-bold rounded-[2px] border border-[#cccccc] transition-all"
            >
              <GithubIcon class="w-4 h-4" />
              <span>Lihat Repositori GitHub</span>
            </a>
          )}
        </div>
      </div>

      {/* Featured Screenshot */}
      {project.data.image && (
        <div class="rounded-[2px] overflow-hidden border border-[#cccccc] mb-12 bg-white">
          <img
            src={project.data.image}
            alt={project.data.title}
            class="w-full h-auto object-cover"
          />
        </div>
      )}

      {/* Markdown Content */}
      <div class="prose max-w-none p-8 rounded-[2px] bg-white border border-[#cccccc] prose-headings:text-black prose-p:text-[#1a1a1a] prose-a:text-[#0046a4] prose-li:text-[#1a1a1a] prose-strong:text-black relative">
        {/* NVIDIA Signature Corner Square */}
        <div class="absolute top-0 right-0 w-3 h-3 bg-[#76b900]"></div>
        <Content />
      </div>

    </div>
  </main>

  <ContactFooter contact={profileData.contact} name={profileData.name} />
  <PdfModal />
</Layout>
